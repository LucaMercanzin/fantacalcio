# Modello dei segreti di Streamlit. NESSUN valore reale in questo file.
#
# In locale: copia questo file in .streamlit/secrets.toml (ignorato da Git)
# e sostituisci il placeholder con l'hash prodotto dal comando:
#
#     python -m dashboard.access
#
# Su Streamlit Community Cloud: App settings -> Secrets, incolla lo stesso
# contenuto (la riga WRITE_PASSWORD_HASH con l'hash, mai la password).
#
# Se la chiave manca o non è un hash valido, le scritture restano disabilitate
# e l'app mostra un avviso (comportamento fail-closed).
#
# Alternativa: variabile d'ambiente FANTACALCIO_WRITE_PASSWORD_HASH con lo stesso hash.

# Formato atteso: pbkdf2_sha256$<iterazioni>$<sale_hex>$<hash_hex>
WRITE_PASSWORD_HASH = "[DA FORNIRE: hash generato con python -m dashboard.access]"
